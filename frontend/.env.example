# Not needed for local dev — Vite's dev server proxies /api requests to
# http://localhost:3000 (see vite.config.js), so the frontend can use
# relative URLs and avoid cross-origin cookie issues.
#
# Only set this if your backend runs somewhere else (e.g. in production,
# where frontend and backend are on different real domains):
# VITE_API_BASE_URL=https://api.yourdomain.com
